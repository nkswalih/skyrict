# Core Service Environment Variables
# Copy to .env and fill in values.
# Prefix: CORE_ (uppercase)
#
# IMPORTANT: These are LOCAL DEV defaults. Staging and production values
# are injected by Kubernetes from per-environment Secrets - never from
# a committed .env file.
#
# Core shares the skyrict_identity Postgres database with identity - see
# services/core/README.md for the RLS / version-table consequences.

# --- Environment (dev-only defaults) ---
CORE_ENVIRONMENT=dev
CORE_DEBUG=true
CORE_LOG_LEVEL=DEBUG
CORE_LOG_JSON=false

# --- Database (REQUIRED - shared skyrict_identity database) ---
CORE_DATABASE_URL=postgresql+asyncpg://skyrict:Skyrict%4011419@localhost:5432/skyrict_identity

# --- JWT verification (REQUIRED - same public key/issuer/audience as identity) ---
# Core only VERIFIES identity-issued access tokens (no signing key, no Redis,
# no MFA key). Local dev: run `uv run python -m skyrict_testing.generate_keys`
# to create gitignored keys at .dev/keys/. Tests generate ephemeral keys.
CORE_JWT_PUBLIC_KEY_PATH=./.dev/keys/public.pem
CORE_JWKS_ISSUER=https://auth.skyrict.io
CORE_JWKS_AUDIENCE=api.skyrict.io

# --- CORS (explicit origins only - wildcard '*' forbidden in staging/production) ---
CORE_CORS_ORIGINS=["http://localhost:3000"]

# --- Multi-tenancy ---
CORE_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
# Tenant subdomain base domain - the first label of <tenant>.BASE_DOMAIN is the
# tenant slug (e.g. acme.skyrict.com -> acme). REQUIRED in staging/production;
# ignored in dev/test where nginx injects X-Tenant-Slug.
CORE_BASE_DOMAIN=skyrict.com

# --- ERP settings ---
CORE_DEFAULT_CURRENCY=USD
CORE_INVENTORY_ADJUST_APPROVE_THRESHOLD=100.00

# --- AI agent integration (SKY-70 product->embedding sync + reindex) ---
# Shared secret core dispatches on POST /ai/inventory/embeddings/sync; must
# match ai-agent's AI_INVENTORY_SYNC_TOKEN. Empty disables the HTTP dispatch
# (feed the snapshot via `ai-agent inventory reindex` instead).
CORE_AI_SYNC_TOKEN=
# Shared secret the ai-agent reindex/ingest CLIs present as a bearer on
# GET /inventory/products; must match ai-agent's AI_INGEST_TOKEN. Empty
# disables the m2m branch (JWT + erp.inventory.read still required). Never
# share or log this value.
CORE_AI_INGEST_TOKEN=
# Base URL of the ai-agent service for /api/v1/ai/* proxying and the sync
# dispatch. In docker networks use http://skyrict-ai-agent:8000.
CORE_AI_AGENT_URL=http://localhost:8002
CORE_AI_AGENT_TIMEOUT_SECONDS=30

# --- Documents (SKY-87) ---
# The same CORE_AI_SYNC_TOKEN above is the shared secret core's post-commit
# document OCR dispatch presents to ai-agent's POST /ai/documents/process.
# ai-agent authenticates the OCR callback (POST /documents/{id}/ocr/result)
# back to core with its DOCUMENT_SYNC_TOKEN (must match). Leave CORE_AI_SYNC_TOKEN
# empty to disable OCR dispatch. Storage backend + cap default to local under
# DOCS_STORAGE_LOCAL_DIR; see core config for the DOCS_* tuning keys.
