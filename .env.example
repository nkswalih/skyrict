# ===========================================
# Skyrict Environment Variables
# Copy to .env and fill in values
# ===========================================

# ---------- Identity Service ----------
IDENTITY_ENVIRONMENT=dev
IDENTITY_DEBUG=true
IDENTITY_DATABASE_URL=postgresql+asyncpg://skyrict:skyrict@localhost:5432/skyrict_identity
IDENTITY_REDIS_URL=redis://localhost:6379/0

# --- JWT RS256 (REQUIRED) ---
# Local dev only: run `uv run python -m skyrict_testing.generate_keys`
# to create gitignored keys at .dev/keys/. Staging/production use
# secret-manager-provisioned keys, never the fixture/test keypair.
IDENTITY_JWT_PRIVATE_KEY_PATH=./.dev/keys/private.pem
IDENTITY_JWT_PUBLIC_KEY_PATH=./.dev/keys/public.pem
IDENTITY_JWKS_ISSUER=https://auth.skyrict.io
IDENTITY_JWKS_AUDIENCE=api.skyrict.io
IDENTITY_ACCESS_TOKEN_EXPIRE_MINUTES=15
IDENTITY_REFRESH_TOKEN_EXPIRE_DAYS=7

IDENTITY_CORS_ORIGINS=["http://localhost:3000"]
IDENTITY_LOG_LEVEL=INFO
IDENTITY_LOG_JSON=false
IDENTITY_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
IDENTITY_RATE_LIMIT_LOGIN=5
IDENTITY_RATE_LIMIT_WINDOW_SECONDS=300

# ---------- Core Service ----------
# Core shares the skyrict_identity Postgres database with identity - no
# separate DB container. RLS function is CREATE OR REPLACE (order-independent)
# and core migrates under its own alembic_version_core table.
CORE_ENVIRONMENT=dev
CORE_DEBUG=true
CORE_LOG_LEVEL=INFO
CORE_LOG_JSON=false
CORE_DATABASE_URL=postgresql+asyncpg://skyrict:skyrict@localhost:5432/skyrict_identity

# --- JWT verification (REQUIRED - same public key/issuer/audience as identity) ---
# Core only VERIFIES identity-issued access tokens (no signing key, no Redis,
# no MFA key). Local dev: run `uv run python -m skyrict_testing.generate_keys`.
CORE_JWT_PUBLIC_KEY_PATH=./.dev/keys/public.pem
CORE_JWKS_ISSUER=https://auth.skyrict.io
CORE_JWKS_AUDIENCE=api.skyrict.io

CORE_CORS_ORIGINS=["http://localhost:3000"]
CORE_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
# Tenant subdomain base domain - required in staging/production; ignored in
# dev/test where nginx injects X-Tenant-Slug.
CORE_BASE_DOMAIN=skyrict.com

# --- ERP settings ---
CORE_DEFAULT_CURRENCY=USD
CORE_INVENTORY_ADJUST_APPROVE_THRESHOLD=100.00

# ---------- Kafka ----------
KAFKA_BROKERS=localhost:9092

# ---------- AI Agent Service ----------
# Full template with comments: services/ai-agent/.env.example
AI_ENVIRONMENT=dev
AI_DATABASE_URL=postgresql+asyncpg://skyrict:skyrict@localhost:5433/skyrict_identity
AI_REDIS_URL=redis://localhost:6379/0
AI_JWT_PUBLIC_KEY_PATH=./.dev/keys/public.pem
AI_JWKS_ISSUER=https://auth.skyrict.io
AI_JWKS_AUDIENCE=api.skyrict.io
# Providers are optional - see the service .env.example for the full set
# (openrouter | groq | openai | omniroute | agentrouter | generic).
# With none configured, AI endpoints return typed 503 ai_unavailable.
INVENTORY_SERVICE_URL=http://localhost:8001
REPORT_SERVICE_URL=http://localhost:8001

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Local multi-tenant routing (Nginx) ----------
# `docker compose` (dev) starts an nginx proxy that routes *.localhost
# subdomains to the identity service and injects X-Tenant-Slug from the
# subdomain - the same header contract as production (acme.skyrict.com).
#
# Local testing with two fake tenants (no DNS setup needed - modern OSes
# resolve *.localhost to 127.0.0.1 automatically):
#   http://acme.localhost/docs      # X-Tenant-Slug: acme
#   http://globex.localhost/docs    # X-Tenant-Slug: globex
#
# Path fallback when wildcard DNS is unavailable:
#   http://localhost/acme/api/v1/health      # -> /api/v1/health + X-Tenant-Slug: acme
#   http://localhost/globex/api/v1/auth/login # -> /api/v1/auth/login + X-Tenant-Slug: globex
#
# Override the host port if 80 is already in use - set NGINX_PORT=8080 in
# infra/docker/.env (or export it in your shell), then hit
# http://acme.localhost:8080/docs.
NGINX_PORT=80
