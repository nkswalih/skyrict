# ===========================================
# Skyrict .gitignore
# Monorepo: Python (uv) + Node.js (pnpm)
# ===========================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
*.whl
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
eggs/
*.tar.gz
*.zip
wheels/
MANIFEST

# ---------- uv ----------
.uv/

# ---------- Testing ----------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
coverage.xml
*.cover
*.py,cover
.hypothesis/
.tox/
.nox/

# ---------- Linting / Formatting ----------
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# ---------- IDEs / Editors ----------
