# RSA keys — NEVER commit key material; tests generate ephemeral keys
*.pem

# Local dev-only files
.dev/

# Local runtime data (GeoLite2 DB etc. — see scripts/geolite2)
.local/

# ---------- Docker ----------
docker-compose.override.yml
docker-compose.override.yaml

# ---------- Node.js / Frontend ----------
node_modules/
.next/
.nuxt/
.output/
out/
.turbo/
pnp.*
.yarn/
*.tsbuildinfo

