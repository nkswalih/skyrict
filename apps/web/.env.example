# The browser never talks to the identity service directly - all auth traffic
# goes through the same-origin /api/auth/* BFF route handlers, and workspace
# API calls go through the /api/v1/* BFF proxy, both of which forward to
# API_PROXY_TARGET below. The tenant slug is always derived server-side from
# the Host header.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Off by default. When the AI-agent supervisor stream fails, the Agents-shell
# chat shows the error copy unless this is "true" (throwaway/dev environments
# only - the simulated reply is a deterministic stub, never production data).
# NEXT_PUBLIC_AGENTS_SIMULATION_ENABLED=false

# Internal design-system reference at /design-system. The route is always
# available in development and returns 404 in production unless this is "true"
# (staging/internal review only; the page is noindex).
# NEXT_PUBLIC_DESIGN_SYSTEM=true

# Server-side only: base URL of the identity service. Defaults to
# http://localhost:8000. The BFF prefixes /api/v1 when proxying.
# API_PROXY_TARGET=http://localhost:8000

# Server-side only: base URL of the Core ERP service. Requests under
# /api/v1/crm, /api/v1/sales, /api/v1/inventory, and /api/v1/documents are
# proxied here.
# CORE_PROXY_TARGET=http://localhost:8001

# Tenant slug for local dev when the Host header has no tenant subdomain
# (e.g. plain localhost:3000 instead of tester.localhost:3000). The value must
# be a real provisioned tenant - reserved platform slugs (web, signup, acme,
# ...) are rejected by the identity service. Server-side only; never set in
# the production posture.
TENANT_SLUG=

# Error tracking (optional - staging/production only): leave unset in dev/test
# to skip Sentry init entirely. NEXT_PUBLIC_SENTRY_DSN rides in the browser
# bundle and is public by design; SENTRY_DSN is server-side only.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
